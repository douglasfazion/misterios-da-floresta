{
  "name": "joca",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/standalone.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build && npm run test:e2e",
    "build:offline": "node scripts/verify-art.mjs && node scripts/build-offline.mjs",
    "test:offline": "node scripts/verify-art.mjs && node scripts/test-offline.mjs",
    "verify:art": "node scripts/verify-art.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1"
  }
}
